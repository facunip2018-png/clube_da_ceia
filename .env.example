# =====================================================================
# Clube da Ceia Perfeita — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel
# (Settings → Environment Variables). NUNCA faça commit de chaves reais.
# =====================================================================

# --- Supabase (obrigatório em produção) -------------------------------
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable / anon). Pode ir para o navegador: quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave de serviço (service_role / secret). SOMENTE servidor: usada no checkout e no webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Endereço público do site ----------------------------------------
# Usado nos links de retorno do pagamento. Ex.: https://clube.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# --- Chef IA (opcional) ----------------------------------------------
# Sem chave, o Chef responde por consulta direta às fichas (sem IA generativa).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Perguntas por pessoa a cada 24 horas
CHEF_DAILY_LIMIT=30

# --- Mercado Pago (Checkout Pro) -------------------------------------
# Mantenha PAYMENTS_ENABLED=false até concluir os testes com credenciais de teste.
PAYMENTS_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" gerada em Suas integrações → Webhooks
MERCADOPAGO_WEBHOOK_SECRET=

# --- Demonstração local ----------------------------------------------
# true = app funciona sem Supabase, com dados no navegador. NUNCA use em produção:
# expõe o catálogo de exemplo (inclusive fichas não publicadas) a qualquer visitante.
# É ignorado quando as chaves do Supabase estão definidas.
NEXT_PUBLIC_DEMO_MODE=false
# true = permite embutir o app em iframes (ambientes de pré-visualização). Em produção, deixe false.
ALLOW_IFRAME_EMBED=false
